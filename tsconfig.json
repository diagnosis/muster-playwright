//tsconfig.json

{
 "compilerOptions": {
   "strict": true,
   "noUncheckedIndexedAccess": true,
   "noEmit": true,
   "target": "es2022",
   "module": "esnext",
   "moduleResolution": "bundler",
   "types": ["node"],
   "paths": {
     "@api/*": ["./src/api/*"],
     "@data/*": ["./src/data/*"],
     "@fixtures/*": ["./src/fixtures/*"],
     "@pages/*": ["./src/pages/*"],
     "@utils/*": ["./src/utils/*"]
   }
 },
  "include": ["src","tests","playwright.config.ts"],

}